# `./bin/trading-agent-local init` generates `.local/env` with absolute paths
# and random secrets. This file documents the local-only runtime contract.
TRADING_AGENT_ENVIRONMENT=local
TRADING_AGENT_ENABLE_ORDER_EXECUTION=false
TRADING_AGENT_DATABASE_URL=sqlite+pysqlite:////ABSOLUTE/PATH/TO/PROJECT/.local/data/trading-agent.db
TRADING_AGENT_IMAGE_ROOT=/ABSOLUTE/PATH/TO/PROJECT/.local/data/images
# User credentials live in SQLite and are managed with `panshi-user`.

TRADING_AGENT_PRIMARY_VISION_PROVIDER=deepseek
TRADING_AGENT_FALLBACK_VISION_PROVIDER=kimi
TRADING_AGENT_DEEPSEEK_MODEL=deepseek-chat
TRADING_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
TRADING_AGENT_DEEPSEEK_ENV_KEY=DEEPSEEK_API_KEY

# Free China-futures data. A free Tq account enables the primary source;
# without it the runtime automatically uses AkShare.
TRADING_AGENT_MARKET_DATA_PROVIDER=free
TRADING_AGENT_MARKET_DATA_HISTORY_LENGTH=240
TRADING_AGENT_MARKET_DATA_TIMEOUT_SECONDS=10
TRADING_AGENT_MARKET_DATA_VALIDATE_EXCHANGE_DAILY=true
TRADING_AGENT_TQSDK_USERNAME=
TRADING_AGENT_TQSDK_PASSWORD=

# Kimi is fail-closed in local mode. Do not enable it without an independently
# reviewed OS/tool isolation boundary.
TRADING_AGENT_KIMI_MODEL=default
TRADING_AGENT_KIMI_EXTERNAL_ISOLATION_VERIFIED=false
TRADING_AGENT_KIMI_ISOLATION_PROVIDER=

TRADING_AGENT_API_TOKEN=generated-by-init
TRADING_AGENT_PRIVACY_REVIEW_TOKEN=generated-by-init
TRADING_API_URL=http://127.0.0.1:8005

# The init command copies this value from the current shell when present.
DEEPSEEK_API_KEY=
